{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2021",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"importHelpers": false,
		"isolatedModules": true,
		"strictNullChecks": true,
		"strict": true,
		"lib": [
			"DOM",
			"ES2021"
		]
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts"
	]
}
